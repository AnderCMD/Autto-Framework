<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- %maskedMsg replaces registered secrets (passwords, tokens, keys) with ****** -->
    <conversionRule conversionWord="maskedMsg" class="io.github.andercmd.autto.core.security.MaskingMessageConverter"/>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%X{scenario:-}] [%X{correlationId:-}] %logger{24} - %maskedMsg%n</pattern>
        </encoder>
    </appender>
    <logger name="org.openqa.selenium" level="WARN"/>
    <logger name="org.springframework" level="WARN"/>
    <logger name="io.github.bonigarcia" level="WARN"/>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
