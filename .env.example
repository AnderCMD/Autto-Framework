# =====================================================================================================================
#  Local secrets and overrides for the test suite.
#
#    cp .env.example .env      (Windows: copy .env.example .env)
#
#  .env is git-ignored and never committed. In CI define the same names as pipeline secrets / variables.
#  Real environment variables always win over this file.
#  Any AUTTO_* variable overrides autto.* settings: AUTTO_BROWSER_NAME=firefox -> autto.browser.name=firefox
# =====================================================================================================================

# --- Application under test ---------------------------------------------------------------------------------------
# Demo store password (public value of saucedemo.com; for a real application use the real secret here)
SAUCE_PASSWORD=
# Optional
# SAUCE_STANDARD_USERNAME=standard_user
# STAGING_BASE_URL=https://staging.example.com

# --- Environment selection ----------------------------------------------------------------------------------------
# SPRING_PROFILES_ACTIVE=qa

# --- Personal overrides -------------------------------------------------------------------------------------------
# AUTTO_BROWSER_NAME=firefox
# AUTTO_BROWSER_HEADLESS=true
# AUTTO_EVIDENCE_VIDEO=always

# --- Cloud providers (profile: browserstack) ----------------------------------------------------------------------
# BROWSERSTACK_USERNAME=
# BROWSERSTACK_ACCESS_KEY=
# SELENIUM_GRID_URL=http://localhost:4444
