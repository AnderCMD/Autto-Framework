<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
    Autto coding standard. It focuses on correctness and on the automation rules of the project
    (no Thread.sleep, no System.out, no assertions libraries mixed...), not on cosmetic preferences.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="SuppressWarningsFilter"/>

    <module name="FileTabCharacter"/>
    <module name="NewlineAtEndOfFile">
        <property name="lineSeparator" value="lf_cr_crlf"/>
    </module>
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^(package|import) |https?://|^\s*\* "/>
    </module>
    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="message" value="Trailing whitespace"/>
    </module>

    <!-- Automation rules -->
    <module name="RegexpSingleline">
        <property name="id" value="noThreadSleep"/>
        <property name="format" value="Thread\.sleep\("/>
        <property name="message" value="Do not use Thread.sleep: use explicit waits (BasePage.waitUntil / Awaitility)"/>
    </module>
    <module name="RegexpSingleline">
        <property name="id" value="noSystemOut"/>
        <property name="format" value="System\.(out|err)\.print|\.printStackTrace\(\)"/>
        <property name="message" value="Use the SLF4J logger or the Report API instead of System.out / printStackTrace"/>
    </module>
    <module name="RegexpSingleline">
        <property name="id" value="noImplicitWait"/>
        <property name="format" value="implicitlyWait\("/>
        <property name="message" value="Implicit waits are configured only by the framework (autto.timeouts.implicit)"/>
    </module>

    <module name="TreeWalker">
        <module name="SuppressWarningsHolder"/>

        <!-- Imports -->
        <module name="AvoidStarImport">
            <property name="allowStaticMemberImports" value="true"/>
        </module>
        <module name="RedundantImport"/>
        <module name="UnusedImports"/>
        <module name="IllegalImport">
            <property name="illegalPkgs" value="org.junit.Assert, junit.framework, org.testng, sun, org.hamcrest"/>
        </module>

        <!-- Naming -->
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="ConstantName"/>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>

        <!-- Correctness -->
        <module name="EqualsHashCode"/>
        <module name="StringLiteralEquality"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="FallThrough"/>
        <module name="MissingOverride"/>
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignored"/>
        </module>
        <module name="EmptyStatement"/>
        <module name="NeedBraces"/>
        <module name="OneStatementPerLine"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>
        <module name="UpperEll"/>
        <module name="ArrayTypeStyle"/>
        <module name="HideUtilityClassConstructor"/>
        <module name="FinalClass"/>
        <module name="IllegalCatch">
            <property name="illegalClassNames" value="java.lang.Throwable, java.lang.Error"/>
        </module>
    </module>
</module>
