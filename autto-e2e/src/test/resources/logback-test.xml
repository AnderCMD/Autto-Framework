<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- %maskedMsg replaces registered secrets (passwords, tokens, keys) with ****** -->
    <conversionRule conversionWord="maskedMsg"
                    class="io.github.andercmd.autto.core.security.MaskingMessageConverter"/>

    <property name="LOG_DIR" value="${autto.report.dir:-target/autto-reports}/logs"/>
    <property name="PATTERN" value="%d{HH:mm:ss.SSS} %-5level [%thread] [%X{scenario:-}] [%X{correlationId:-}] %logger{24} - %maskedMsg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) [%thread] %cyan(%logger{24}) - %maskedMsg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_DIR}/autto.log</file>
        <append>false</append>
        <encoder>
            <pattern>${PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Quiet down noisy libraries -->
    <logger name="org.openqa.selenium" level="WARN"/>
    <logger name="io.github.bonigarcia" level="WARN"/>
    <logger name="org.springframework" level="WARN"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="io.appium" level="WARN"/>
    <logger name="org.jcodec" level="WARN"/>
    <logger name="com.github.dockerjava" level="WARN"/>

    <logger name="io.github.andercmd.autto" level="${autto.log.level:-INFO}"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
